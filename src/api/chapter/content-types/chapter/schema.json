{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapter"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "chapter_topics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chapter-topic.chapter-topic",
      "mappedBy": "chapter"
    },
    "quizzes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz.quiz",
      "mappedBy": "chapter"
    }
  }
}
