    },
    "heroes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hero.hero",
      "mappedBy": "city"
    },
    "foods": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::food.food",
      "mappedBy": "city"
    },
    "cultures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::culture.culture",
      "mappedBy": "city"
    }
